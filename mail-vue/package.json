{
  "name": "mail-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite --mode dev",
    "remote": "vite --mode remote",
    "build": "vite build --mode release",
    "eo": "vite build --mode eo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath mail-vue/.husky || true"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@vueuse/components": "^14.1.0",
    "@vueuse/core": "^12.0.0",
    "axios": "1.15.2",
    "compressorjs": "^1.2.1",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.11",
    "dompurify": "^3.4.16",
    "echarts": "^5.6.0",
    "element-plus": "^2.13.1",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.10",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "less": "^4.2.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "sass": "^1.82.0",
    "terser": "^5.39.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
